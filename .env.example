# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://*.onrender.com

# Database (PostgreSQL example)
# DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DBNAME
DATABASE_URL=

# Redis / Celery
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Email. Leave Gmail SMTP as the fallback. When CLOUDFLARE_API_TOKEN is set,
# every message is sent through Cloudflare (smtp.mx.cloudflare.net) and the
# mailbox shown to people is aniketkapale02@gmail.com.
EMAIL_BACKEND=apps.core.email_backend.ProjectEmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
PROJECT_MAIL=aniketkapale02@gmail.com
DEFAULT_FROM_EMAIL="Aniket.ProjectMate" <aniketkapale02@gmail.com>
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SITE_NAME=Aniket.ProjectMate
SITE_URL=http://127.0.0.1:8000

# Media storage: local | cloudinary | s3
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Auth — Google OAuth (required for "Continue with Google")
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# 2) Authorized redirect URI: {SITE_URL}/accounts/google/login/callback/
#    Example: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ProjectMateBot uses a built-in ProjectMate knowledge base (no API key needed)

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
